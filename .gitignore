# =============================================================================
# Cattle Feed ERP — Root .gitignore
# =============================================================================

# Dependencies
node_modules/
.npm-cache/
.tmp-recording/

# Environment & secrets (NEVER commit)
.env
.env.*
!.env.example
!.env.production.example

# Build outputs (generated in CI / build script — do not commit)
frontend/dist/
deploy/hostinger-upload.zip
deploy/hostinger-public_html/*
!deploy/hostinger-public_html/.htaccess

# Logs
*.log
backend/logs/*.log
!backend/logs/.gitkeep

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# FTP deploy state (created on server by CI, not in repo)
.ftp-deploy-sync-state.json

# Uploads & temp
backend/uploads/*
!backend/uploads/.gitkeep

# Coverage / test artifacts
coverage/
.nyc_output/
