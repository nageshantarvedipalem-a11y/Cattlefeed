# Server
NODE_ENV=development
PORT=5001
API_PROJECT_SLUG=cattlefeed
API_VERSION=v1

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=cattle_feed_erp
DB_CONNECTION_LIMIT=100

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_key_in_production
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10000
DISABLE_RATE_LIMIT=true

# WhatsApp Cloud API (Phase 15)
WHATSAPP_PROVIDER=meta
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# AiSensy (alternative WhatsApp provider)
AISENSY_API_KEY=
AISENSY_INVOICE_CAMPAIGN=
# Invoice campaign template must use {{1}} name, {{2}} invoice no, {{3}} total, {{4}} paid, {{5}} balance
AISENSY_REMINDER_CAMPAIGN=
AISENSY_API_URL=https://backend.aisensy.com/campaign/t1/api/v2

# Public backend URL (required for AiSensy invoice PDF links)
APP_PUBLIC_URL=https://your-backend-domain.example.com

# Application
APP_NAME=Cattle Feed ERP
DEFAULT_ADMIN_EMAIL=admin@cattlefeed.com
