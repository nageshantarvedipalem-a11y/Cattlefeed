# Server
NODE_ENV=development
PORT=5001
API_PROJECT_SLUG=cattlefeed
API_VERSION=v1

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=cattle_feed_erp
DB_CONNECTION_LIMIT=10

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_key_in_production
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WhatsApp Cloud API (Phase 15)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Application
APP_NAME=Cattle Feed ERP
DEFAULT_ADMIN_EMAIL=admin@cattlefeed.com
